# Copy these names into local .env or Render settings. Replace placeholders; never commit real credentials.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Groq is for text and prompt enhancement only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Dedicated image generation provider.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# Existing news monitoring and Facebook settings.
NEWS_FEEDS=
ENABLE_AUTO_MONITORING=true
NEWS_CHECK_INTERVAL_SECONDS=600
ENABLE_FACEBOOK_PUBLISHING=false
COOKIE_SECURE=true
